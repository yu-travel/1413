#include <stdio.h>
#include <stdlib.h>
#include <sys/mman.h>
#include <fcntl.h>
#include <unistd.h>
#include <signal.h>

// 腾锐D2000 GPIO1控制器基地址
#define GPIO1_BASE       0x28005000
#define GPIO_DIR_OFFSET  0x0c  // 方向控制寄存器偏移
#define GPIO_OUT_OFFSET  0x10  // 输出电平寄存器偏移
#define GPIO1_B4_BIT     (1 << 4)  // GPIO1_B4 对应bit4

// 全局变量：用于退出时释放资源
void *gpio1_virt_base = NULL;
int mem_fd = -1;

// 信号处理：Ctrl+C退出时恢复资源
void sigint_handler(int sig) {
    printf("\n捕获退出信号，释放资源...\n");

    // 释放内存映射
    if (gpio1_virt_base != NULL) {
        munmap(gpio1_virt_base, 4096);
        gpio1_virt_base = NULL;
    }
    // 关闭文件
    if (mem_fd >= 0) {
        close(mem_fd);
        mem_fd = -1;
    }

    printf("程序已退出\n");
    exit(0);
}

// 初始化并设置GPIO1_B4为【输出+持续低电平】
int gpio1_b4_set_low(void) {
    // 1. 打开物理内存（root权限）
    mem_fd = open("/dev/mem", O_RDWR | O_SYNC);
    if (mem_fd < 0) {
        perror("打开/dev/mem失败（需sudo运行）");
        return -1;
    }

    // 2. 映射物理地址到虚拟地址
    gpio1_virt_base = mmap(NULL, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, mem_fd, GPIO1_BASE);
    if (gpio1_virt_base == MAP_FAILED) {
        perror("内存映射失败");
        close(mem_fd);
        mem_fd = -1;
        return -1;
    }

    // 3. 配置为输出模式（仅修改bit4，不影响其他引脚）
    volatile unsigned int *gpio_dir = (volatile unsigned int *)(gpio1_virt_base + GPIO_DIR_OFFSET);
    *gpio_dir |= GPIO1_B4_BIT;  // bit4置1 → 输出模式
    printf("GPIO1_B4 已设为输出模式\n");

    // 4. 设置为低电平（核心：清bit4为0）
    volatile unsigned int *gpio_out = (volatile unsigned int *)(gpio1_virt_base + GPIO_OUT_OFFSET);
    *gpio_out &= ~GPIO1_B4_BIT;  // 清bit4 → 低电平
    printf("GPIO1_B4 已设为持续低电平\n");

    return 0;
}

int main(int argc, char *argv[]) {
    // 注册Ctrl+C信号处理
    signal(SIGINT, sigint_handler);

    // 初始化并设置低电平
    if (gpio1_b4_set_low() != 0) {
        printf("GPIO1_B4 设置低电平失败\n");
        return -1;
    }

    // 保持程序运行（低电平持续生效）
    printf("GPIO1_B4 已稳定输出低电平（按Ctrl+C退出）\n");
    while (1) {
        sleep(1);  // 空循环，保持程序运行
    }

    return 0;
}
